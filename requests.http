@baseUrl = http://localhost:3333

### ================= RESPONSÁVEIS =================

### Criar responsável
# @name novoResponsavel
POST {{baseUrl}}/responsaveis
Content-Type: application/json

{
  "nome": "Ana Souza",
  "email": "ana@email.com",
  "telefone": "(11) 91234-5678",
  "cpf": "123.456.789-00"
}

### Criar responsável inválido (mostra a validação do Zod)
POST {{baseUrl}}/responsaveis
Content-Type: application/json

{
  "nome": "A",
  "email": "email-errado",
  "telefone": "123",
  "cpf": "000"
}

### Listar responsáveis
GET {{baseUrl}}/responsaveis

### Buscar responsável por id
GET {{baseUrl}}/responsaveis/{{novoResponsavel.response.body.id}}

### Atualizar responsável
PUT {{baseUrl}}/responsaveis/{{novoResponsavel.response.body.id}}
Content-Type: application/json

{
  "nome": "Ana Souza Lima",
  "email": "ana@email.com",
  "telefone": "(11) 98888-7777",
  "cpf": "123.456.789-00"
}

### ================= PETS =================

### Criar pet
# @name novoPet
POST {{baseUrl}}/pets
Content-Type: application/json

{
  "nome": "Rex",
  "especie": "cachorro",
  "raca": "Vira-lata",
  "idade": 3,
  "peso": 12.5,
  "responsavelId": "{{novoResponsavel.response.body.id}}"
}

### Criar pet inválido
POST {{baseUrl}}/pets
Content-Type: application/json

{
  "nome": "Mia",
  "especie": "dragao",
  "idade": -1,
  "peso": 0,
  "responsavelId": "abc"
}

### Listar pets
GET {{baseUrl}}/pets

### Buscar pet por id
GET {{baseUrl}}/pets/{{novoPet.response.body.id}}

### Atualizar pet
PUT {{baseUrl}}/pets/{{novoPet.response.body.id}}
Content-Type: application/json

{
  "nome": "Rex",
  "especie": "cachorro",
  "raca": "Vira-lata",
  "idade": 4,
  "peso": 13.2,
  "responsavelId": "{{novoResponsavel.response.body.id}}"
}

### ================= CONSULTAS =================

### Criar consulta
# @name novaConsulta
POST {{baseUrl}}/consultas
Content-Type: application/json

{
  "petId": "{{novoPet.response.body.id}}",
  "veterinario": "Dr. Carlos",
  "data": "2026-10-01T14:30:00Z",
  "motivo": "Vacina anual",
  "valor": 150
}

### Listar consultas
GET {{baseUrl}}/consultas

### Buscar consulta por id
GET {{baseUrl}}/consultas/{{novaConsulta.response.body.id}}

### Atualizar consulta
PUT {{baseUrl}}/consultas/{{novaConsulta.response.body.id}}
Content-Type: application/json

{
  "petId": "{{novoPet.response.body.id}}",
  "veterinario": "Dr. Carlos",
  "data": "2026-10-01T14:30:00Z",
  "motivo": "Vacina anual",
  "status": "realizada",
  "valor": 150
}

### ================= REMOÇÕES (na ordem certa) =================

### Tentar remover responsável com pets (409)
DELETE {{baseUrl}}/responsaveis/{{novoResponsavel.response.body.id}}

### Remover consulta
DELETE {{baseUrl}}/consultas/{{novaConsulta.response.body.id}}

### Remover pet
DELETE {{baseUrl}}/pets/{{novoPet.response.body.id}}

### Remover responsável
DELETE {{baseUrl}}/responsaveis/{{novoResponsavel.response.body.id}}
